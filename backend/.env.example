# Адрес AD. Рекомендуется ldaps://dc.rvk.local:636 (или ldap:// + AD_START_TLS=true),
# иначе доменные пароли передаются по сети открытым текстом.
AD_SERVER=ldaps://
AD_START_TLS=false
# Проверять сертификат контроллера домена (CA из системного хранилища или AD_CA_CERTS_FILE)
AD_TLS_VALIDATE=true
AD_CA_CERTS_FILE=
AD_TIMEOUT_SECONDS=10

AD_USER=
AD_PASSWORD=
AD_SEARCH_BASE=
# Корень оргструктуры (OU с отделами). Если пусто — используется AD_SEARCH_BASE
AD_DEPARTMENTS_BASE=
# Домен, добавляемый к логину при входе: user -> user@RVK.local
AD_DOMAIN=RVK.local
# Необязательно: собственный LDAP-фильтр пользователей.
# По умолчанию: только люди, без компьютеров и отключённых учёток.
# AD_USER_FILTER=

# Обязательно: случайная строка >= 32 символов, например:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Допустимо: HS256, HS384, HS512
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Защита от подбора пароля: не больше N неудачных попыток входа на логин за окно (сек.)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# true, если справочник открывается по HTTPS
AUTH_COOKIE_SECURE=false

# Логины администраторов через запятую (без домена или в виде user@RVK.local)
ADMIN_USERS=

# Origin'ы фронтенда через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=sqlite+aiosqlite:///./phonebook.db
