# Только зашифрованное подключение: ldaps://dc.rvk.local:636
# (или ldap:// + AD_USE_STARTTLS=true)
AD_SERVER=ldaps://
AD_USE_STARTTLS=false
# PEM с корневым сертификатом CA домена (если его нет в системном хранилище)
AD_CA_CERT_FILE=
# Разрешить открытый ldap:// без шифрования. Только временно: пароли идут открытым текстом!
AD_ALLOW_INSECURE=false
# Служебная учётка; нужны права чтения и записи атрибута telephoneNumber
AD_USER=
AD_PASSWORD=
AD_SEARCH_BASE=
# Записываемый контроллер домена (не RODC). Если пусто — используется AD_SERVER
AD_WRITE_SERVER=
# Строка шифров OpenSSL. DEFAULT:@SECLEVEL=1 принимает слабые ключи сертификатов DC,
# DEFAULT:@SECLEVEL=0 — совсем старые
AD_TLS_CIPHERS=
# Корень оргструктуры (OU с отделами). Если пусто — используется AD_SEARCH_BASE
AD_DEPARTMENTS_BASE=
# Домен для входа: пользователь вводит "ivanov", bind выполняется как "ivanov@AD_DOMAIN"
AD_DOMAIN=RVK.local
AD_CONNECT_TIMEOUT=5

# Плановая синхронизация из AD (по местному времени сервера)
AD_SYNC_ENABLED=true
AD_SYNC_TIMES=08:00,20:00

# Обязательно, не короче 32 символов.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=zwEvlbtdptgrTHOuNPy8p-SEdCBNciIFoqxiIphg8gI3M5AzF65eCWoNQiknk3CS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Главные администраторы через запятую (ivanov,petrov). Только они могут
# назначать других администраторов в веб-интерфейсе

ADMIN_USERS=

# Ограничение попыток входа. Неудачи на логин держите НИЖЕ порога блокировки в AD.
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_SECONDS=300

# Swagger (/docs, /redoc, /openapi.json) — только для разработки
ENABLE_DOCS=false

DATABASE_URL=sqlite+aiosqlite:///./phonebook.db
